# ============================================================
# Clean URLs — serve pages without the .html extension
# lucasmachut.com/contato  ->  contato.html
# ============================================================

RewriteEngine On

# 1. Send the homepage's index.html to the bare root (avoid /index)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2. Redirect any direct .html request to its clean URL (301, canonical)
#    Matches the literal request line so it never loops on the rewrite below.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2b. Anciennes adresses. Elles sont dans les propostas PDF, la bio
#     Instagram et les mails de prospection déjà envoyés : on redirige,
#     on ne déplace pas en silence.
#     La page Fotos a été supprimée, le portfólio la remplace.
RewriteRule ^fotos/?$ /portfolio [R=301,L]
RewriteRule ^(en|fr)/fotos/?$ /$1/portfolio [R=301,L]

#     La branche hôtelière est descendue dans /lugares/.
RewriteRule ^hoteis/?$              /lugares/ [R=301,L]
RewriteRule ^portfolio-hoteis/?$    /lugares/portfolio [R=301,L]
RewriteRule ^regard/?$              /lugares/regard [R=301,L]
RewriteRule ^villa-egeu/?$          /lugares/villa-egeu [R=301,L]
RewriteRule ^sempre-vivo/?$         /lugares/sempre-vivo [R=301,L]
RewriteRule ^villa-balthazar/?$     /lugares/villa-balthazar [R=301,L]
#     contact était la page B2B : elle devient le contato de lugares,
#     tandis que /contato sert désormais le B2C.
RewriteRule ^contact/?$             /lugares/contato [R=301,L]
#     Parador est retiré du portfólio.
RewriteRule ^parador/?$             /lugares/portfolio [R=301,L]

# 3. Internally serve the .html file when a clean URL is requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ============================================================
# Caching — keep the site fresh when a file changes at the same URL
# (photos replaced via /admin reuse their filename, so the browser
# must revalidate instead of showing a stale cached copy).
# ============================================================
<IfModule mod_headers.c>
  # Pages, gallery data and images: always revalidate with the server.
  # Unchanged files return a cheap 304; changed ones are re-fetched.
  <FilesMatch "\.(html|json|jpe?g|png|webp|gif)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS/JS are cache-busted via ?v= in the markup, so cache them hard.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
