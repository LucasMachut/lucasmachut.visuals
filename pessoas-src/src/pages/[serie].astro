---
// Une page par série publiée de data/pessoas/trabalhos.json, en portugais ;
// /fr/ et /en/ sont dans pages/[lang]/. Corps : views/Serie.astro.
import Serie from '../views/Serie.astro';
import { publishedSeries } from '../lib/series.js';

export function getStaticPaths() {
  const all = publishedSeries();
  return all.map((s, i) => ({ params: { serie: s.slug }, props: { s, next: all[(i + 1) % all.length] } }));
}
---
<Serie lang="pt" s={Astro.props.s} next={Astro.props.next} />
