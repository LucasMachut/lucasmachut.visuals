---
// Accueil pessoas : hero, puis les sections dans l'ordre choisi dans l'admin
// (data.sections, ordre de Koisei par défaut : manifeste, film du jour, offres,
// tombée de la nuit, film de la nuit), puis le pied de page.
// Une section masquée (hidden) n'est pas publiée mais garde son contenu.
// Tout le texte vient de data/pessoas/accueil.json (et de sa traduction
// data/pessoas/<lang>/accueil.json), les fichiers que l'admin modifie.
import Base from '../layouts/Base.astro';
import HomeStage from '../components/HomeStage.jsx';
import Manifesto from '../components/Manifesto.jsx';
import Film from '../components/Film.jsx';
import Oferta from '../components/Oferta.jsx';
import Nightfall from '../components/Nightfall.jsx';
import Fim from '../components/Fim.jsx';
import pt from '../../../data/pessoas/accueil.json';
import { inLang } from '../lib/i18n.js';
import '../styles/home.css';
import '../styles/home-sections.css';

const { lang = 'pt' } = Astro.props;
const data = inLang(lang, 'accueil', pt);
const sections = (data.sections || []).filter((s) => !s.hidden);
---
<Base title={data.seo.title} description={data.seo.description} nav={data.nav} cta={data.nav_cta} lang={lang} path="/">
  <HomeStage client:load hero={data.hero} />
  {sections.map((s, i) => (
    <div class="sec" data-sec={s.id} data-covers-hero={i === 0 ? '' : undefined}>
      {s.id === 'manifesto' && (
        <section id="journey" class="journey"><Manifesto client:load data={data.manifesto} /></section>
      )}
      {s.id === 'film_dia' && <Film client:load id="film1" variant="dia" data={data.film_dia} />}
      {s.id === 'oferta' && <Oferta client:load data={data.oferta} />}
      {s.id === 'noite' && <Nightfall client:load data={data.noite} />}
      {s.id === 'film_noite' && <Film client:load id="film2" variant="noite" data={data.film_noite} />}
    </div>
  ))}
  <Fim client:load data={data.fim} />
</Base>
